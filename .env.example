# ─── Copie ce fichier en ".env" et remplis les valeurs ───
# cp .env.example .env

# Clé privée du wallet Solana (base58). Laisse vide en paper mode.
SOLANA_PRIVATE_KEY=

# RPC Solana (Helius recommandé pour la fiabilité)
HELIUS_RPC_URL=https://api.mainnet-beta.solana.com

# Telegram (optionnel — laisse vide pour désactiver les notifs)
TELEGRAM_TOKEN=
CHAT_ID=

# Modes
# PAPER_MODE=true  → faux argent (DÉFAUT, sécurité)
# PAPER_MODE=false → trade RÉEL (n'active que si tu sais ce que tu fais)
PAPER_MODE=true
DRY_RUN=false

# Dashboard
DASHBOARD_PASSWORD=purecrypto2026
PORT=8080
